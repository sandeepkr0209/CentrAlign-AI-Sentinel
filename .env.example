# Copy to .env (never commit .env). Everything is optional.
# You supply, and pay for, your own API usage. SENTINEL never ships or stores keys.
#
# LLM_PROVIDER: groq | anthropic | (unset or "none" = free rule-based planner, no LLM)
LLM_PROVIDER="groq or anthropic"
GROQ_API_KEY="api key for groq"
ANTHROPIC_API_KEY="api key for anthropic"

LLM_MODEL="provide which model to use, e.g., groq=openai/gpt-oss-120b, anthropic=claude-haiku-4-5-20251001"
SENTINEL_MAX_ITER=20
SENTINEL_MAX_RETRIES=3
SENTINEL_TOOL_TIMEOUT=10
SENTINEL_DB=data/sentinel.db
